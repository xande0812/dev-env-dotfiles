{
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "aws-core@agent-toolkit-for-aws": true,
    "deploy-on-aws@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "extraKnownMarketplaces": {
    "agent-toolkit-for-aws": {
      "source": {
        "repo": "aws/agent-toolkit-for-aws",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/home/human/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "language": "japanese",
  "model": "claude-fable-5[1m]",
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.aws.amazon.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:pnpm.io)",
      "WebFetch(domain:docs.github.com)",
      "Read(~/obvault/AI/**)",
      "Write(~/obvault/AI/**)",
      "Edit(~/obvault/AI/**)"
    ],
    "defaultMode": "plan",
    "deny": [
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/op/**)",
      "Read(**/.env*)",
      "Read(/proc/*/environ)",
      "Read(~/.claude/.credentials.json)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(http *)",
      "Bash(https *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git pull)",
      "Bash(git pull *)",
      "Bash(git clone *)"
    ]
  },
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "command": "bash /home/human/.claude/statusline-command.sh",
    "type": "command"
  },
  "theme": "dark-daltonized",
  "tui": "default"
}