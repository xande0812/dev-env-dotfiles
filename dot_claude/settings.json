{
  "permissions": {
    "defaultMode": "plan",
    "deny": [
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/op/**)",
      "Read(**/.env*)",
      "Read(/proc/*/environ)",
      "Read(~/.claude/.credentials.json)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(http *)",
      "Bash(https *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git pull)",
      "Bash(git pull *)",
      "Bash(git clone *)",
      "WebFetch"
    ],
    "allow": [
      "WebSearch",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.aws.amazon.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:pnpm.io)",
      "WebFetch(domain:docs.github.com)"
    ]
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "effortLevel": "xhigh",
  "language": "japanese",
  "tui": "fullscreen"
}
