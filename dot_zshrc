# managed by chezmoi (dev-env-dotfiles). 編集は source 側 (dot_zshrc) で。

# mise: 開発ツール (node/ripgrep/eza/starship/sheldon/git-wt/ghq 等) を PATH に出す。
# 他の eval より先に置く必要がある。
eval "$(mise activate zsh)"

# --- history ---
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_ALL_DUPS HIST_EXPIRE_DUPS_FIRST

# --- completion + plugins ---
# sheldon: zsh-completions(fpath) → compinit → fzf-tab の順で source する。
eval "$(sheldon source)"

# git-wt: `git wt <branch>` 実行後に新 worktree へ自動 cd する git() wrapper。
# compinit / fzf-tab の後に評価する必要がある。
eval "$(git-wt --init zsh)"

# ghq + fzf: `ghq list` を fzf で選んで cd する widget。Ctrl-G にバインド。
ghq-fzf-widget() {
  local selected
  selected=$(ghq list | fzf) || return
  if [ -n "${selected}" ]; then
    BUFFER="cd $(ghq root)/${selected}"
    zle accept-line
  fi
  zle reset-prompt
}
zle -N ghq-fzf-widget
bindkey '^g' ghq-fzf-widget

# zsh-autosuggestions: widget を wrap するので fzf-tab の後・syntax-highlighting の前。
[ -r /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ] && \
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# --- prompt ---
eval "$(starship init zsh)"

# direnv: cd した瞬間に .envrc を読み、プロジェクトごとの env へ切り替える。
# direnv は mise 管理 (mise activate で PATH に出る)。未許可の .envrc は実行されない
# (whitelist は direnv.toml に入れていない = 各プロジェクトで明示 allow する opt-in)。
eval "$(direnv hook zsh)"

# --- aliases (eza ベース) ---
alias ls='eza'
alias ll='eza -l --git'
alias la='ls -al'
alias lt='eza --tree'
alias lla='eza -la --git'
alias lg='lazygit'

# AI agent CLI は既定で bwrap sandbox 版を呼ぶ (低権限 = ANTHROPIC_API_KEY / OAuth のみ)。
# commit signing / AWS read-only / dotenv 復号が要るときは claude-with-* / codex-with-*
# を明示的に呼ぶ。生バイナリは `command claude` / `mise which claude` で。
# wrapper 本体は ansible が /usr/local/bin に配置する (dev-env-playbook/roles/bwrap_wrappers)。
alias claude='claude-sandboxed'
alias codex='codex-sandboxed'
alias cl='claude-sandboxed'
alias cl-g='claude-with-git'
alias cl-aws='claude-with-aws-ro'
alias cl-env='claude-with-dotenv'
alias cx='codex-sandboxed'
alias cx-g='codex-with-git'
alias cx-aws='codex-with-aws-ro'
alias cx-env='codex-with-dotenv'

# --- functions ---

# ntmux [name]: 今のシェルの env を引き継いだ、専用 socket (`-L`) の tmux server を
# <name> という名前で起動 / そこへ attach する。AWS_* や dotenv 等の secret 入りシェルを
# socket 単位で隔離した tmux に閉じ込める用途。
#   - name 省略時は ntmux-<PID> (呼び出しシェルの PID) を socket 名にして新規 server を
#     立てる。後から `tmux -L ntmux-<PID> attach` で入り直せる (PID は ps で辿れる)。
#   - `-L $name` で毎回別 socket になるので、env (credential) がこの server だけに
#     焼かれる (他 session に漏れない)。同名なら既存 server に attach するだけ。
#   - `-e` で env を渡さない = secret が ps / history に乗らない。env は exec した
#     tmux server プロセスが現シェルから継承する。
ntmux() {
  emulate -L zsh
  local name=${1:-ntmux-$$}

  # 既にその専用 server があれば入るだけ
  if tmux -L "$name" has-session 2>/dev/null; then
    exec tmux -L "$name" attach
  fi
  # 無ければ: 今のシェル (env 入り) から新規 server を起動
  exec tmux -L "$name" new-session -s main
}

# zsh-syntax-highlighting は必ず最後に source する。
[ -r /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] && \
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
